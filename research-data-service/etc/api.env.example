# 服务器 B：读取 API + MCP。复制为 etc/api.env，由 IT 填写，不要提交凭证。
# MySQL 使用只读账号；对象存储账号仅需对应图片前缀的 GetObject 权限。
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
# REQUIRED 强制 TLS；取得 CA 后使用 VERIFY_IDENTITY 验证证书及主机名。
MYSQL_SSL_MODE=REQUIRED
# MYSQL_SSL_CA=/path/to/mysql-ca.pem
XSKY_ENDPOINT=
XSKY_BUCKET=
XSKY_ACCESS_KEY=
XSKY_SECRET_KEY=
XSKY_REGION=us-east-1
XSKY_ADDRESSING_STYLE=path
# XSKY_CA_BUNDLE=/path/to/xsky-ca.pem

# 与采集管理令牌分开的读取令牌及游标签名密钥。
CORPUS_READ_API_TOKEN=
CORPUS_CURSOR_SECRET=
CORPUS_READ_HOST=127.0.0.1
CORPUS_READ_PORT=8000
LOG_LEVEL=INFO
# 客户端可访问的对象存储入口；省略时使用 XSKY_ENDPOINT。
# CORPUS_IMAGE_PUBLIC_ENDPOINT=https://objects.internal.example
# MCP 默认调用本机 API；不需要配置成采集服务器地址。
# CORPUS_DATA_API_BASE_URL=http://127.0.0.1:8000
# 对外提供服务时添加服务器 B 的实际域名、端口和协议。
# CORPUS_MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,corpus.internal.example:8000
# CORPUS_MCP_ALLOWED_ORIGINS=http://127.0.0.1:*,http://localhost:*,https://corpus.internal.example
