# Server B sync worker only. Do not give write credentials to the query process.
CORPUS_COLLECTOR_URL=https://collector.internal.example
CORPUS_TRANSFER_TOKEN=
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_SSL_MODE=REQUIRED
# MYSQL_SSL_CA=/path/to/mysql-ca.pem
XSKY_ENDPOINT=
XSKY_BUCKET=
XSKY_ACCESS_KEY=
XSKY_SECRET_KEY=
XSKY_REGION=us-east-1
XSKY_PREFIX=overseas-corpus/images
XSKY_ADDRESSING_STYLE=path
# XSKY_CA_BUNDLE=/path/to/xsky-ca.pem
LOG_LEVEL=INFO

# Server B's background classifier. BASE_URL is the OpenAI-compatible API root including /v1.
ARIS_LLM_BASE_URL=
ARIS_LLM_API_KEY=
ARIS_LLM_MODEL=
# CORPUS_LABEL_TAXONOMY=/path/to/label-taxonomy.json
