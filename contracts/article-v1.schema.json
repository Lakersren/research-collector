{
  "$defs": {
    "Image": {
      "additionalProperties": false,
      "properties": {
        "position": {
          "minimum": 1,
          "title": "Position",
          "type": "integer"
        },
        "status": {
          "enum": [
            "ok",
            "failed",
            "pending"
          ],
          "title": "Status",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "width": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Width"
        },
        "height": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Height"
        }
      },
      "required": [
        "position",
        "status"
      ],
      "title": "Image",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "maxLength": 191,
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "source_id": {
      "maxLength": 191,
      "minLength": 1,
      "title": "Source Id",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "authors": {
      "items": {
        "type": "string"
      },
      "title": "Authors",
      "type": "array"
    },
    "published_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Published At"
    },
    "url": {
      "pattern": "^https?://",
      "title": "Url",
      "type": "string"
    },
    "content_state": {
      "enum": [
        "ready",
        "preview",
        "no_text"
      ],
      "title": "Content State",
      "type": "string"
    },
    "content": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Content"
    },
    "images": {
      "items": {
        "$ref": "#/$defs/Image"
      },
      "title": "Images",
      "type": "array"
    }
  },
  "required": [
    "id",
    "source_id",
    "title",
    "authors",
    "published_at",
    "url",
    "content_state",
    "content",
    "images"
  ],
  "title": "Article",
  "type": "object"
}
